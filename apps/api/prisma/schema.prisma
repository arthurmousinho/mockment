generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PaymentStatus {
  CREATED
  PROCESSING
  APPROVED
  DECLINED
  CANCELED
}

enum PaymentCurrency {
  BRL
  USD
  EUR
}

enum PaymentMethod {
  CARD
  PIX
  BANK_SLIP
}

enum PaymentEventType {
  PAYMENT_CREATED
  PAYMENT_PROCESSING
  PAYMENT_APPROVED
  PAYMENT_DECLINED
  PAYMENT_CANCELED
}

enum EventType {
  PAYMENT_CREATED
  PAYMENT_PROCESSING
  PAYMENT_APPROVED
  PAYMENT_DECLINED
  PAYMENT_CANCELED

  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_RESUMED
  SUBSCRIPTION_CANCELED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  PAUSED
  CANCELED
}

model ApiKey {
  id String @id @default(uuid())

  name    String
  keyHash String @unique @map("key_hash")

  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  payments         Payment[]
  webhookEndpoints WebhookEndpoint[]
  checkouts        Checkout[]
  subscriptions    Subscription[]

  @@map("api_keys")
}

model Payment {
  id String @id @default(uuid())

  amountInCents Int             @map("amount_in_cents")
  currency      PaymentCurrency
  method        PaymentMethod
  status        PaymentStatus   @default(CREATED)

  description String?

  externalId     String? @map("external_id")
  idempotencyKey String? @map("idempotency_key")

  apiKeyId String @map("api_key_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKey        ApiKey         @relation(fields: [apiKeyId], references: [id])
  paymentEvents PaymentEvent[]
  checkouts     Checkout[]
  events        Event[]

  @@unique([apiKeyId, externalId])
  @@unique([apiKeyId, idempotencyKey])
  @@map("payments")
}

model PaymentEvent {
  id String @id @default(uuid())

  paymentId String           @map("payment_id")
  type      PaymentEventType
  payload   Json?

  createdAt DateTime @default(now()) @map("created_at")

  payment           Payment           @relation(fields: [paymentId], references: [id])
  webhookDeliveries WebhookDelivery[]

  @@index([paymentId])
  @@index([type])
  @@map("payment_events")
}

model Event {
  id String @id @default(uuid())

  type    EventType
  payload Json?

  paymentId      String? @map("payment_id")
  subscriptionId String? @map("subscription_id")

  createdAt DateTime @default(now()) @map("created_at")

  payment      Payment?      @relation(fields: [paymentId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  webhookDeliveries WebhookDelivery[]

  @@index([type])
  @@index([paymentId])
  @@index([subscriptionId])
  @@index([createdAt])
  @@map("events")
}

model WebhookEndpoint {
  id String @id @default(uuid())

  url      String
  secret   String
  events   Json // String[] is not supported by MySQL
  apiKeyId String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKey            ApiKey            @relation(fields: [apiKeyId], references: [id])
  webhookDeliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id String @id @default(uuid())

  status     WebhookDeliveryStatus @default(PENDING)
  statusCode Int?                  @map("status_code")
  error      String?

  endpointId     String @map("endpoint_id")
  paymentEventId String @map("payment_event_id")

  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id])
  paymentEvent PaymentEvent    @relation(fields: [paymentEventId], references: [id])
  event        Event?          @relation(fields: [eventId], references: [id])
  eventId      String?

  @@index([endpointId])
  @@index([paymentEventId])
  @@index([status])
  @@map("webhook_deliveries")
}

model Checkout {
  id String @id @default(uuid())

  successUrl String @map("success_url")
  cancelUrl  String @map("cancel_url")

  apiKeyId       String  @map("api_key_id")
  paymentId      String  @map("payment_id")
  subscriptionId String? @map("subscription_id")

  createdAt DateTime @default(now()) @map("created_at")

  payment      Payment       @relation(fields: [paymentId], references: [id])
  apiKey       ApiKey        @relation(fields: [apiKeyId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([apiKeyId])
  @@map("checkouts")
}

model Subscription {
  id String @id @default(uuid())

  description String?

  amountInCents Int             @map("amount_in_cents")
  currency      PaymentCurrency
  method        PaymentMethod

  interval      BillingInterval
  intervalCount Int             @default(1)

  status SubscriptionStatus @default(PENDING)

  nextBillingAt DateTime? @map("next_billing_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  apiKeyId  String     @map("api_key_id")
  apiKey    ApiKey     @relation(fields: [apiKeyId], references: [id])
  checkouts Checkout[]
  events    Event[]

  @@map("subscriptions")
}

model VirtualClock {
  id String @id @default("default")

  currentDateTime DateTime @map("current_datetime")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("virtual_clock")
}
