generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PaymentStatus {
  CREATED
  PROCESSING
  APPROVED
  DECLINED
  CANCELED
}

enum PaymentCurrency {
  BRL
  USD
  EUR
}

enum PaymentMethod {
  CARD
  PIX
  BANK_SLIP
}

enum EventType {
  PAYMENT_CREATED
  PAYMENT_PROCESSING
  PAYMENT_APPROVED
  PAYMENT_DECLINED
  PAYMENT_CANCELED

  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_RESUMED
  SUBSCRIPTION_CANCELED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  PAUSED
  CANCELED
}

enum SimulationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum SimulationStepRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model ApiKey {
  id String @id

  name    String
  keyHash String @unique @map("key_hash")

  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  payments         Payment[]
  webhookEndpoints WebhookEndpoint[]
  checkouts        Checkout[]
  subscriptions    Subscription[]

  @@map("api_keys")
}

model Payment {
  id String @id

  amountInCents Int             @map("amount_in_cents")
  currency      PaymentCurrency
  method        PaymentMethod
  status        PaymentStatus   @default(CREATED)

  description String?

  externalId     String? @map("external_id")
  idempotencyKey String? @map("idempotency_key")

  apiKeyId String @map("api_key_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKey    ApiKey     @relation(fields: [apiKeyId], references: [id])
  events    Event[]
  checkouts Checkout[]

  @@unique([apiKeyId, externalId])
  @@unique([apiKeyId, idempotencyKey])
  @@map("payments")
}

model Event {
  id String @id

  type    EventType
  payload Json?

  paymentId      String? @map("payment_id")
  subscriptionId String? @map("subscription_id")

  createdAt DateTime @default(now()) @map("created_at")

  payment           Payment?          @relation(fields: [paymentId], references: [id])
  subscription      Subscription?     @relation(fields: [subscriptionId], references: [id])
  webhookDeliveries WebhookDelivery[]

  @@index([type])
  @@index([paymentId])
  @@index([subscriptionId])
  @@index([createdAt])
  @@map("events")
}

model WebhookEndpoint {
  id String @id

  url      String
  secret   String
  events   Json // String[] is not supported by MySQL
  apiKeyId String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKey            ApiKey            @relation(fields: [apiKeyId], references: [id])
  webhookDeliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id String @id

  status     WebhookDeliveryStatus @default(PENDING)
  statusCode Int?                  @map("status_code")
  error      String?

  endpointId String @map("endpoint_id")
  eventId    String @map("event_id")

  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])
  event    Event           @relation(fields: [eventId], references: [id])

  @@index([endpointId])
  @@index([eventId])
  @@index([status])
  @@map("webhook_deliveries")
}

model Checkout {
  id String @id

  successUrl String @map("success_url")
  cancelUrl  String @map("cancel_url")

  apiKeyId       String  @map("api_key_id")
  paymentId      String  @map("payment_id")
  subscriptionId String? @map("subscription_id")

  createdAt DateTime @default(now()) @map("created_at")

  payment      Payment       @relation(fields: [paymentId], references: [id])
  apiKey       ApiKey        @relation(fields: [apiKeyId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([apiKeyId])
  @@map("checkouts")
}

model Subscription {
  id String @id

  description String?

  amountInCents Int             @map("amount_in_cents")
  currency      PaymentCurrency
  method        PaymentMethod

  interval      BillingInterval
  intervalCount Int             @default(1)

  status SubscriptionStatus @default(PENDING)

  nextBillingAt DateTime? @map("next_billing_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  apiKeyId  String     @map("api_key_id")
  apiKey    ApiKey     @relation(fields: [apiKeyId], references: [id])
  checkouts Checkout[]
  events    Event[]

  @@map("subscriptions")
}

model VirtualClock {
  id String @id @default("default")

  currentDateTime DateTime @map("current_datetime")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("virtual_clock")
}

model SimulationScenario {
  id String @id

  name           String
  description    String?
  stepIntervalMs Int?            @map("step_interval_ms")
  steps          Json
  runs           SimulationRun[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("simulation_scenarios")
}

model SimulationRun {
  id String @id

  scenarioId String              @map("scenario_id")
  status     SimulationRunStatus @default(PENDING)

  currentStep Int   @default(0) @map("current_step")
  totalSteps  Int   @map("total_steps")
  error       Json?

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  scenario SimulationScenario  @relation(fields: [scenarioId], references: [id])
  steps    SimulationStepRun[]

  @@index([scenarioId])
  @@map("simulation_runs")
}

model SimulationStepRun {
  id String @id

  runId     String                  @map("run_id")
  stepIndex Int                     @map("step_index")
  status    SimulationStepRunStatus @default(PENDING)

  input  Json?
  output Json?
  error  Json?

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  run SimulationRun @relation(fields: [runId], references: [id])

  @@unique([runId, stepIndex])
  @@index([runId, status])
  @@map("simulation_step_runs")
}
