generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PaymentStatus {
  CREATED
  PROCESSING
  APPROVED
  DECLINED
  CANCELED
  REFUNDED
}

enum PaymentCurrency {
  BRL
  USD
  EUR
}

enum PaymentMethod {
  CARD
  PIX
  BANK_SLIP
}

enum InvoiceStatus {
  CREATED
  PROCESSING
  ISSUED
  CANCELED
}

enum EventType {
  CHECKOUT_CREATED
  CHECKOUT_COMPLETED
  CHECKOUT_CANCELED
  CHECKOUT_EXPIRED

  PAYMENT_CREATED
  PAYMENT_PROCESSING
  PAYMENT_APPROVED
  PAYMENT_DECLINED
  PAYMENT_CANCELED
  PAYMENT_REFUNDED

  SUBSCRIPTION_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_RESUMED
  SUBSCRIPTION_CANCELED

  INVOICE_CREATED
  INVOICE_PROCESSING
  INVOICE_ISSUED
  INVOICE_REJECTED
  INVOICE_CANCELED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  PAUSED
  CANCELED
}

enum SimulationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum SimulationStepRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum CheckoutStatus {
  OPEN
  COMPLETED
  CANCELED
  EXPIRED
}

model ApiKey {
  id String @id

  name    String
  keyHash String @unique @map("key_hash")

  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("api_keys")
}

model Product {
  id String @id

  name         String
  description  String?
  priceInCents Int             @map("price_in_cents")
  currency     PaymentCurrency
  enabled      Boolean         @default(true)
  externalId   String          @unique @map("external_id")

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  checkoutItems CheckoutItem[]

  @@map("products")
}

model Payment {
  id String @id

  amountInCents Int             @map("amount_in_cents")
  currency      PaymentCurrency
  method        PaymentMethod
  status        PaymentStatus   @default(CREATED)
  customerId    String?
  description   String?

  externalId     String? @map("external_id")
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id])
  checkout Checkout?
  invoices Invoice[]

  @@unique([externalId])
  @@unique([idempotencyKey])
  @@map("payments")
}

model Invoice {
  id String @id

  status        InvoiceStatus   @default(CREATED)
  amountInCents Int             @map("amount_in_cents")
  currency      PaymentCurrency
  customerId    String          @map("customer_id")
  paymentId     String          @map("payment_id")

  issuedAt  DateTime? @map("issued_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("invoices")
}

model Event {
  id String @id

  type    EventType
  payload Json?

  resourceId String? @map("resource_id")

  createdAt         DateTime          @default(now()) @map("created_at")
  webhookDeliveries WebhookDelivery[]

  @@index([type])
  @@index([createdAt])
  @@index([resourceId])
  @@map("events")
}

model WebhookEndpoint {
  id String @id

  url     String
  secret  String
  events  Json // String[] is not supported by MySQL
  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  webhookDeliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id String @id

  status     WebhookDeliveryStatus @default(PENDING)
  statusCode Int?                  @map("status_code")
  error      String?

  endpointId String @map("endpoint_id")
  eventId    String @map("event_id")

  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])
  event    Event           @relation(fields: [eventId], references: [id])

  @@index([endpointId])
  @@index([eventId])
  @@index([status])
  @@map("webhook_deliveries")
}

model Checkout {
  id String @id

  status         CheckoutStatus  @default(OPEN)
  amountInCents  Int             @map("amount_in_cents")
  currency       PaymentCurrency
  allowedMethods Json            @map("allowed_methods")
  successUrl     String          @map("success_url")
  cancelUrl      String          @map("cancel_url")
  customerId     String?         @map("customer_id")

  paymentId      String? @unique @map("payment_id")
  subscriptionId String? @map("subscription_id")

  expiresAt   DateTime? @map("expires_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  payment      Payment?       @relation(fields: [paymentId], references: [id])
  customer     Customer?      @relation(fields: [customerId], references: [id])
  subscription Subscription?  @relation(fields: [subscriptionId], references: [id])
  items        CheckoutItem[]

  @@map("checkouts")
}

model CheckoutItem {
  id String @id

  checkoutId String @map("checkout_id")
  productId  String @map("product_id")

  quantity          Int @default(1)
  unitAmountInCents Int @map("unit_amount_in_cents")

  checkout Checkout @relation(fields: [checkoutId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([checkoutId])
  @@index([productId])
  @@map("checkout_items")
}

model Subscription {
  id String @id

  status        SubscriptionStatus @default(PENDING)
  amountInCents Int                @map("amount_in_cents")
  currency      PaymentCurrency
  method        PaymentMethod
  interval      BillingInterval
  intervalCount Int                @default(1)
  customerId    String

  description String?

  nextBillingAt DateTime? @map("next_billing_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer  Customer   @relation(fields: [customerId], references: [id])
  checkouts Checkout[]

  @@map("subscriptions")
}

model Customer {
  id String @id

  name       String
  email      String @unique
  phone      String
  document   String @unique
  externalId String @unique @map("external_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments      Payment[]
  subscriptions Subscription[]
  invoices      Invoice[]
  checkouts     Checkout[]

  @@map("customers")
}

model VirtualClock {
  id String @id @default("default")

  currentDateTime DateTime @map("current_datetime")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("virtual_clock")
}

model SimulationScenario {
  id String @id

  name           String
  description    String?
  stepIntervalMs Int?            @map("step_interval_ms")
  steps          Json
  runs           SimulationRun[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("simulation_scenarios")
}

model SimulationRun {
  id String @id

  scenarioId String              @map("scenario_id")
  status     SimulationRunStatus @default(PENDING)

  currentStep Int   @default(0) @map("current_step")
  totalSteps  Int   @map("total_steps")
  error       Json?

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  scenario SimulationScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  steps    SimulationStepRun[]

  @@index([scenarioId])
  @@map("simulation_runs")
}

model SimulationStepRun {
  id   String  @id
  name String?

  runId     String                  @map("run_id")
  stepIndex Int                     @map("step_index")
  status    SimulationStepRunStatus @default(PENDING)

  input  Json?
  output Json?
  error  Json?

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepIndex])
  @@index([runId, status])
  @@map("simulation_step_runs")
}
